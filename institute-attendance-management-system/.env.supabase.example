# Copia este archivo como .env.supabase.local y NO lo subas a git.
# La SERVICE_ROLE_KEY solo se usa para importar datos desde tu computadora.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# Archivo generado por npm run supabase:export
MIGRATION_FILE=migration-output/supabase-normalized-YYYY-MM-DD.json
